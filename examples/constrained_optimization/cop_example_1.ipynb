    "#\n",
    "#\n",
    "#\n",
    "import scipy.optimize as opt\n",
    "\n",
    "# find minimum of function\n",
    "# y = x^2 - 3x - 2\n",
    "\n",
    "def func(x):\n",
    "    return x**2 - 3*x - 2\n",
    "\n",
    "# initial guess\n",
    "x0 = 2.0\n",
    "\n",
    "result = opt.minimize(func, x0)\n",
    "print(result.message, result.x, result.fun)\n"
   ]
